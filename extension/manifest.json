{
  "manifest_version": 3,
  "name": "SparSchiene",
  "version": "0.1.0",
  "description": "Prüft mit deinen echten bahn.de-Fahrten, ob sich deine BahnCard gelohnt hat. Liest nur, nichts verlässt deinen Browser.",
  "homepage_url": "https://xsebo99.github.io/SparSchiene/",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "SparSchiene öffnen",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.bahn.de/*"],
      "js": ["core.js", "bahn.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://xsebo99.github.io/SparSchiene/*", "http://localhost:8765/*", "http://127.0.0.1:8765/*"],
      "js": ["site.js"],
      "run_at": "document_end"
    }
  ]
}
